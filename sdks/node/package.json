{
    "name": "@assinavelox/sdk",
    "version": "1.0.0",
    "private": true,
    "description": "SDK Node.js (TypeScript) da API v1 da AssinaVelox — gerado da especificação OpenAPI, sem dependências",
    "license": "UNLICENSED",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "npm run build && node --test test/*.test.mjs"
    },
    "devDependencies": {
        "@types/node": "^18.19.0",
        "typescript": "^5.9.0"
    },
    "engines": {
        "node": ">=18"
    }
}
