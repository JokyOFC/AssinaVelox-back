        <env name="ASSINAVELOX_FEATURE_FIELD_ANCHORS" value="false"/>
        <env name="ASSINAVELOX_FEATURE_FISCAL_INVOICES" value="false"/>
        <env name="ASSINAVELOX_FEATURE_GOVBR_RETURN" value="false"/>
        <env name="ASSINAVELOX_FEATURE_HUBSPOT" value="false"/>
