###############################################################################
# AssinaVelox — modelo de ambiente
#
# Copie para `.env` e preencha. NENHUM VALOR REAL DE SEGREDO ENTRA NESTE ARQUIVO,
# que é versionado. Segredos ficam só no `.env` (chmod 600) do servidor ou, melhor,
# no ambiente do processo (EnvironmentFile do systemd / pool do PHP-FPM).
#
# ATENÇÃO: com `php artisan config:cache` o Laravel NÃO lê o `.env` em execução.
# Toda variável que precisa existir em tempo de execução — a senha do certificado,
# principalmente — tem de estar no ambiente real do processo.
#
# Marcação usada abaixo:
#   [PROD]  obrigatória em produção (sem ela o sistema não funciona ou fica inseguro)
#   [SEG]   é segredo: nunca commitar, nunca colar em log/ticket
#
# Documentação: docs/configuracao.md (referência), docs/implantacao.md (produção),
# docs/operacao.md (plantão).
###############################################################################


###############################################################################
# 1. APLICAÇÃO
###############################################################################

APP_NAME=AssinaVelox
# local | testing | production                                          [PROD]
APP_ENV=local
# [PROD][SEG] `php artisan key:generate`. Também decifra organizations.tax_id
# (cast `encrypted`) e deriva o HMAC dos códigos OTP: trocar sem migrar os dados
# torna o CNPJ das organizações ilegível. Rotação: docs/implantacao.md §13.
APP_KEY=
# [PROD] NUNCA `true` em produção: a página de erro expõe configuração e código.
APP_DEBUG=true
# [PROD] Base de TODOS os links enviados por e-mail e de toda URL absoluta.
# Só este host (e seus subdomínios) é aceito; `Host` forjado é recusado.
APP_URL=http://localhost:8000

# Chaves antigas, separadas por vírgula, aceitas para DECIFRAR durante uma rotação
# de APP_KEY. Remova depois de recifrar os dados.
APP_PREVIOUS_KEYS=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Modo de manutenção (`php artisan down`): file | cache.
APP_MAINTENANCE_DRIVER=file
# Store de cache quando APP_MAINTENANCE_DRIVER=cache.
APP_MAINTENANCE_STORE=database

# Custo do bcrypt. Os testes usam 4 (phpunit.xml).
BCRYPT_ROUNDS=12

# Trabalhadores do servidor embutido `php artisan serve` (só desenvolvimento).
# PHP_CLI_SERVER_WORKERS=4


###############################################################################
# 2. REGISTRO (LOG)
###############################################################################

LOG_CHANNEL=stack
# Canais do stack, separados por vírgula. Produção: `daily` (ou `daily,structured`).
LOG_STACK=single
# [PROD] Em produção use `warning`. `debug` só para investigar, e por pouco tempo.
LOG_LEVEL=debug
# Dias de retenção do canal `daily`.
LOG_DAILY_DAYS=14
# Canal das mensagens de descontinuação do PHP/Laravel (`null` = descartar).
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

# Canal `structured`: uma linha JSON por evento, para coleta por agente externo.
LOG_STRUCTURED_STREAM=
LOG_STRUCTURED_STACKTRACES=false

# Mascaramento de dados sensíveis no registro (App\Logging\RedactSensitiveData).
# Ligado por padrão; a lista de chaves está em config/assinavelox.php. NÃO desligue.
ASSINAVELOX_LOG_REDACTION=true

# Canal `stderr` (contêiner/systemd): classe de formatador do Monolog.
LOG_STDERR_FORMATTER=
# Canal `syslog`.
LOG_SYSLOG_FACILITY=


###############################################################################
# 3. BANCO DE DADOS
###############################################################################

# [PROD] mysql em produção. Os testes usam sqlite em memória (phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assinavelox
# [PROD] Usuário de RUNTIME: sem DDL e sem UPDATE/DELETE em audit_events
# (docs/banco-de-dados.md §4.3). O usuário de migrations é outro, usado só no deploy.
DB_USERNAME=root
# [PROD][SEG]
DB_PASSWORD=

# URL completa no lugar das chaves acima (mysql://usuario:senha@host:porta/banco).
DB_URL=
# Socket UNIX em vez de TCP.
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# CA para TLS com o MySQL (opcional).
MYSQL_ATTR_SSL_CA=
# Só SQLite: aplicar chaves estrangeiras.
DB_FOREIGN_KEYS=true


###############################################################################
# 4. SESSÃO
###############################################################################

# database mantém a sessão viva através de reinícios do Redis.
SESSION_DRIVER=database
# Minutos de inatividade até a sessão expirar. A política "encerrar sessões após
# N horas" da organização é independente e mais restritiva.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
# [PROD] Cookie só por HTTPS. Vazio = `true` quando APP_ENV=production.
SESSION_SECURE_COOKIE=
# lax é o correto aqui: o retorno do Checkout Pro é uma navegação de terceiro.
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PARTITIONED_COOKIE=false
# Nome do cookie (vazio = derivado de APP_NAME).
SESSION_COOKIE=
# Tabela e conexão quando SESSION_DRIVER=database.
SESSION_TABLE=sessions
SESSION_CONNECTION=
# Store quando SESSION_DRIVER=cache.
SESSION_STORE=


###############################################################################
# 5. CACHE
###############################################################################

# [PROD] `redis` em produção; `database` em desenvolvimento.
CACHE_STORE=database
# Prefixo das chaves (vazio = derivado de APP_NAME). Obrigatório separar se dois
# ambientes compartilharem o mesmo Redis.
CACHE_PREFIX=

# Store `database`.
DB_CACHE_TABLE=cache
DB_CACHE_CONNECTION=
DB_CACHE_LOCK_TABLE=
DB_CACHE_LOCK_CONNECTION=
# Store `redis`.
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
# Store `file`.
CACHE_STORAGE_DISK=
CACHE_STORAGE_PATH=framework/cache/data


###############################################################################
# 6. FILA
###############################################################################

# [PROD] `redis` + Horizon em produção; `database` em desenvolvimento;
# `sync` nos testes (phpunit.xml).
QUEUE_CONNECTION=database

# Driver de registro dos jobs falhos.
QUEUE_FAILED_DRIVER=database-uuids

# Conexão `database`.
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
# Segundos até a fila devolver um job reservado para processamento. Precisa ser
# MAIOR que o maior `timeout` de job — FinalizeEnvelope leva até 600 s. Abaixo
# disso a fila devolve o job enquanto ele ainda roda e o trabalho é duplicado.
# Guardado por tests/Feature/Hardening/QueueTimeoutsTest.php.
DB_QUEUE_RETRY_AFTER=900

# Conexão `redis`.
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
# Mesma regra do DB_QUEUE_RETRY_AFTER acima.
REDIS_QUEUE_RETRY_AFTER=900

# Filas usadas (config/assinavelox.php → queues):
#   default | conversions | notifications | finalization | billing
# Worker de desenvolvimento:
#   php artisan queue:work --queue=default,conversions,notifications,finalization,billing


###############################################################################
# 7. REDIS  (obrigatório em produção: fila + cache)
###############################################################################

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# [PROD][SEG]
REDIS_PASSWORD=
REDIS_USERNAME=
# Banco lógico da conexão `default` (fila) e da conexão `cache`.
REDIS_DB=0
REDIS_CACHE_DB=1
# URL completa no lugar das chaves acima.
REDIS_URL=
# Prefixo das chaves (vazio = derivado de APP_NAME).
REDIS_PREFIX=
# Conexão persistente e política de repetição.
REDIS_PERSISTENT=false
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
# Modo de cluster (`redis` = cluster nativo do phpredis). Não usado na Fase 1.
REDIS_CLUSTER=redis


###############################################################################
# 8. E-MAIL
###############################################################################

# Adaptador da aplicação (App\Integrations\Contracts\EmailProvider):
#   laravel = usa o mailer de config/mail.php
#   log     = FAKE de desenvolvimento: nada é transmitido, recibo sempre `unknown`
ASSINAVELOX_EMAIL_PROVIDER=laravel
# Mailer específico (vazio = mail.default).
ASSINAVELOX_EMAIL_MAILER=
# Canal de log do provedor fake (vazio = canal padrão).
ASSINAVELOX_EMAIL_LOG_CHANNEL=

# [PROD] Em produção: smtp (ou outro transporte real). `log` NÃO envia nada —
# é o erro de configuração mais comum e mais silencioso deste sistema.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
# tls | ssl | vazio
MAIL_SCHEME=
# [SEG]
MAIL_USERNAME=
# [SEG]
MAIL_PASSWORD=
# [PROD] Remetente. O domínio precisa de SPF/DKIM/DMARC configurados.
MAIL_FROM_ADDRESS="nao-responda@assinavelox.local"
MAIL_FROM_NAME="${APP_NAME}"
# Domínio anunciado no EHLO (vazio = host de APP_URL).
MAIL_EHLO_DOMAIN=
# URL completa do transporte (smtp://usuario:senha@host:porta) no lugar das chaves acima.
MAIL_URL=
# Mailer `sendmail`.
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# Mailer `log`: canal de destino (vazio = padrão).
MAIL_LOG_CHANNEL=


###############################################################################
# 9. ARMAZENAMENTO DE DOCUMENTOS
###############################################################################

# Disco padrão do Laravel (NÃO é o dos documentos).
FILESYSTEM_DISK=local

# [PROD] Disco privado dos documentos: local (storage/app/documents) ou s3.
# Em qualquer um dos dois, `visibility=private` e nenhuma URL pública: todo
# download passa por um controller autorizado.
DOCUMENTS_DISK=local

# Só com DOCUMENTS_DISK=s3. O bucket precisa ser PRIVADO.
# [SEG]
DOCUMENTS_S3_KEY=
# [SEG]
DOCUMENTS_S3_SECRET=
DOCUMENTS_S3_REGION=
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_USE_PATH_STYLE_ENDPOINT=false
DOCUMENTS_S3_ROOT=

# Criptografia em repouso. O Flysystem não cifra nada sozinho.
#  - S3: a cifra é do lado do servidor e é CONSULTADA ao backend por `storage:verify`.
#  - disco local: não há consulta possível a partir do PHP. A cifra é do volume
#    (LUKS/BitLocker) e só pode ser ATESTADA pelo operador — o que é registrado
#    como atestação, jamais como verificação.
ASSINAVELOX_STORAGE_ENCRYPTION_ATTESTED=false
# Referência humana da atestação (ex.: "LUKS2 /dev/vg0/documents, ticket OPS-431").
ASSINAVELOX_STORAGE_ENCRYPTION_NOTE=
# SSE esperada no S3: AES256 (SSE-S3) ou aws:kms (SSE-KMS).
ASSINAVELOX_STORAGE_S3_SSE=AES256

# Disco genérico `s3` e valores de reserva dos DOCUMENTS_S3_*.
# [SEG]
AWS_ACCESS_KEY_ID=
# [SEG]
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false


###############################################################################
# 10. FERRAMENTAS DE PDF  (tools/pdftool + LibreOffice)
###############################################################################

# Interpretador Python do venv. Vazio = tools/pdftool/.venv/{bin/python,Scripts/python.exe}.
# Sem o venv, NADA de PDF funciona: composição, imagem→PDF, assinatura, validação.
PDFTOOL_PYTHON=

# Binário do LibreOffice para converter DOCX→PDF. Vazio = conversão de DOCX
# indisponível (o upload de DOCX é recusado com mensagem clara).
#   Linux:   /usr/bin/soffice
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_BIN=

# Tempos-limite (segundos) dos processos filhos.
PDFTOOL_TIMEOUT_SECONDS=60
PDFTOOL_SIGN_TIMEOUT_SECONDS=120
LIBREOFFICE_TIMEOUT_SECONDS=120

# Raiz dos diretórios temporários exclusivos por operação (0700, removidos em finally).
# Vazio = storage/app/tmp/pdftool.
PDFTOOL_TMP_PATH=

# Raízes de confiança (PEM/DER) da validação PAdES, separadas por ";". Sem elas,
# `validate` só afirma integridade (trusted=false). Revogação NUNCA é verificada.
PDFTOOL_TRUST_ROOTS=


###############################################################################
# 11. CERTIFICADO A1 DA OPERADORA  (assinatura PAdES B-B — opcional)
###############################################################################
# Sem certificado, o envelope conclui como ACEITE ELETRÔNICO COM EVIDÊNCIAS
# (signature_status = none) e a interface diz isso. Nada é simulado.

COMPANY_CERT_ENABLED=false

# test | production. `production` SOMENTE com A1 emitido por AC da ICP-Brasil em
# nome da operadora. Certificado de `gen-test-cert` é autoassinado, tem TESTE no CN
# e NUNCA pode ser apresentado como ICP-Brasil.
COMPANY_CERT_ENVIRONMENT=test

# Caminho absoluto do PKCS#12 (.pfx/.p12). Fora do repositório, chmod 400,
# legível apenas pelo usuário do worker.
COMPANY_CERT_PFX_PATH=

# NOME da variável de ambiente que contém a senha do PKCS#12 — nunca a senha.
# O VALOR (variável COMPANY_CERT_PASSWORD, ou o nome definido aqui) NÃO fica neste
# arquivo: defina-o só no ambiente do processo do worker (EnvironmentFile do systemd).
# Com `config:cache` o `.env` não é lido em execução.                       [SEG]
COMPANY_CERT_PASSWORD_ENV=COMPANY_CERT_PASSWORD

COMPANY_CERT_NAME="Certificado da operadora"
# Motivo e local gravados no campo de assinatura PAdES.
COMPANY_CERT_REASON="Assinatura eletrônica AssinaVelox"
COMPANY_CERT_LOCATION=Brasil


###############################################################################
# 12. ASSINAVELOX — REGRAS DO DOMÍNIO
###############################################################################

# --- Termos e prazos --------------------------------------------------------
# Versão dos Termos gravada no cadastro e em cada aceite.
ASSINAVELOX_TERMS_VERSION=2026-09
# Prazo padrão de assinatura (dias); cada organização pode alterar entre 1 e 90.
ASSINAVELOX_DEFAULT_EXPIRATION_DAYS=30
# Antecedência do aviso "seu prazo está acabando" (horas).
ASSINAVELOX_EXPIRATION_WARNING_HOURS=48
# Envelopes processados por execução dos comandos agendados.
ASSINAVELOX_EXPIRATION_BATCH_SIZE=200

# --- Código por e-mail do signatário (OTP) ----------------------------------
# O código nunca é gravado em claro nem aparece em log: só o HMAC derivado da APP_KEY.
ASSINAVELOX_OTP_TTL_MINUTES=10
ASSINAVELOX_OTP_MAX_ATTEMPTS=5
# Reenvios por link de convite, por hora.
ASSINAVELOX_OTP_RESEND_LIMIT=5
# Intervalo mínimo entre dois envios do código (segundos).
ASSINAVELOX_OTP_RESEND_INTERVAL_SECONDS=60
# Freio adicional: envios por endereço IP, por hora.
ASSINAVELOX_OTP_IP_HOURLY_LIMIT=30

# --- Sessão do signatário ---------------------------------------------------
ASSINAVELOX_SIGNING_SESSION_TTL_MINUTES=30
ASSINAVELOX_AUTHORIZATION_TTL_MINUTES=10
# Janela de download concedida no aceite (minutos). Fora dela, `sign.download` é 404:
# ter a URL do convite não é o mesmo que ter confirmado o código.
ASSINAVELOX_DOWNLOAD_GRANT_MINUTES=30

# --- Imagem da assinatura (representação visual) ----------------------------
# Toda imagem é reprocessada com GD e reescrita como PNG sem metadados; SVG é recusado.
# Os limites são conferidos ANTES de decodificar.
ASSINAVELOX_SIGNATURE_MAX_DECODED_KB=3072
ASSINAVELOX_SIGNATURE_MAX_SOURCE_PIXELS=8000000

# --- Reenvio de convites ----------------------------------------------------
ASSINAVELOX_RESEND_THROTTLE_MINUTES=10
ASSINAVELOX_MAX_RESENDS=5
# "Lembrar todos os pendentes": 1× por hora por organização.
ASSINAVELOX_BULK_RESEND_THROTTLE_MINUTES=60

# --- Upload -----------------------------------------------------------------
# A validação real é feita sobre o CONTEÚDO (finfo + assinatura de bytes + inspeção
# do ZIP do DOCX + cabeçalho da imagem), nunca pela extensão informada.
# nginx (client_max_body_size) e PHP (upload_max_filesize/post_max_size) precisam
# aceitar um pouco MAIS que este valor, para que o erro venha da aplicação.
ASSINAVELOX_MAX_UPLOAD_MB=25
# Anti "zip bomb" no DOCX.
ASSINAVELOX_DOCX_MAX_UNCOMPRESSED_MB=300
ASSINAVELOX_DOCX_MAX_COMPRESSION_RATIO=150
ASSINAVELOX_DOCX_MAX_ENTRIES=2000
# Limites de imagem lidos do cabeçalho, antes de qualquer decodificação.
ASSINAVELOX_IMAGE_MAX_MEGAPIXELS=40
ASSINAVELOX_IMAGE_MAX_SIDE_PX=20000

# --- Página de evidências ---------------------------------------------------
# Exibição de IP na página de evidências e na trilha: masked | full | none.
ASSINAVELOX_EVIDENCE_SHOW_IP=masked
ASSINAVELOX_EVIDENCE_PAPER=a4
# NÃO troque por uma fonte sem cobertura Unicode: "ação" viraria "a??o" no PDF.
ASSINAVELOX_EVIDENCE_FONT="DejaVu Sans"
# Limite de eventos impressos na linha do tempo.
ASSINAVELOX_EVIDENCE_TIMELINE_LIMIT=200
# Rodapé com a URL de verificação carimbado em todas as páginas do documento final.
ASSINAVELOX_EVIDENCE_FOOTER=true

# --- Convites de membros e organização --------------------------------------
ASSINAVELOX_INVITATION_EXPIRES_DAYS=7
# Dias entre a solicitação de exclusão da organização e a exclusão efetiva.
ASSINAVELOX_ORG_DELETION_GRACE_DAYS=30

# --- Contadores da sidebar --------------------------------------------------
ASSINAVELOX_COUNTS_CACHE_TTL=60
# Vazio = store padrão (CACHE_STORE).
ASSINAVELOX_COUNTS_CACHE_STORE=

# --- Unidade de consumo do plano (Fase 1: envelope_sent) --------------------
ASSINAVELOX_PLAN_CONSUMPTION_UNIT=envelope_sent

# --- Ajuda e suporte exibidos na interface ----------------------------------
ASSINAVELOX_HELP_URL=https://ajuda.assinavelox.com.br
ASSINAVELOX_SUPPORT_EMAIL=suporte@assinavelox.com.br


###############################################################################
# 13. SEGURANÇA
###############################################################################

# [PROD] Proxies confiáveis (X-Forwarded-*): lista de IPs/CIDRs do balanceador,
# separada por vírgula (ex.: 10.0.0.0/8). Vazio = nenhum.
# Define o IP registrado nos aceites e nos eventos de auditoria, e a chave dos
# limitadores por IP.
# NÃO use "*": ele significa "confie em qualquer origem", e então o X-Forwarded-For
# passa a ser escrito pelo próprio cliente. Por segurança, com "*" a aplicação
# IGNORA o X-Forwarded-For (o IP volta a ser o do socket) e mantém apenas
# X-Forwarded-Proto/Port. O X-Forwarded-Host nunca é confiado.
TRUSTED_PROXIES=

# [PROD] Content-Security-Policy com nonce por resposta (middleware SecurityHeaders).
# Valide com REPORT_ONLY=true antes de bloquear.
ASSINAVELOX_CSP_ENABLED=true
ASSINAVELOX_CSP_REPORT_ONLY=false
# Origens adicionais permitidas, separadas por vírgula (ex.: CDN de assets).
ASSINAVELOX_CSP_EXTRA_SOURCES=

# Permissions-Policy. Vazio = a lista de negação padrão de config/assinavelox.php
# (nenhuma tela usa câmera, microfone, geolocalização, sensores ou Payment Request).
ASSINAVELOX_PERMISSIONS_POLICY=

# Cross-Origin-Opener-Policy. `same-origin-allow-popups` preserva window.opener para
# o retorno do Checkout Pro aberto em outra aba; `same-origin` é mais estrito.
ASSINAVELOX_COOP=same-origin-allow-popups
# Cross-Origin-Resource-Policy: nenhuma resposta nossa deve ser embutida por terceiros.
ASSINAVELOX_CORP=same-origin

# Segredo do identificador de usuário das passkeys do Fortify. Vazio = APP_KEY.
# Passkeys não estão habilitadas na Fase 1.                                  [SEG]
PASSKEYS_USER_HANDLE_SECRET=


###############################################################################
# 14. OBSERVABILIDADE E SAÚDE
###############################################################################

# Devolver o identificador de correlação no cabeçalho X-Correlation-Id.
# É um ULID opaco, não um segredo, e encurta muito o suporte.
ASSINAVELOX_CORRELATION_HEADER=true

# Limiares dos indicadores de `php artisan assinavelox:doctor`. São avisos
# operacionais, não SLA contratual (docs/operacao.md §2).
ASSINAVELOX_HEALTH_QUEUE_BACKLOG=100
ASSINAVELOX_HEALTH_FAILED_WINDOW_HOURS=24
ASSINAVELOX_HEALTH_CONVERSION_STUCK_MINUTES=30
ASSINAVELOX_HEALTH_FINALIZATION_STUCK_MINUTES=30
ASSINAVELOX_HEALTH_DELIVERY_STUCK_MINUTES=60
ASSINAVELOX_HEALTH_WEBHOOK_STUCK_MINUTES=30
# Aviso de vencimento do certificado A1 (dias). Comece a renovação com 90.
ASSINAVELOX_HEALTH_CERT_WARNING_DAYS=30


###############################################################################
# 15. TRILHA DE AUDITORIA (checkpoint encadeado)
###############################################################################
# `audit:checkpoint` exporta os eventos de um período e grava um resumo encadeado.
# Isso torna DETECTÁVEL uma alteração posterior — não a impede.

# Disco do Flysystem onde o lote é gravado (privado, nunca público).
ASSINAVELOX_AUDIT_CHECKPOINT_DISK=documents
ASSINAVELOX_AUDIT_CHECKPOINT_PATH=audit-checkpoints
# Eventos lidos por página ao montar o lote (memória previsível).
ASSINAVELOX_AUDIT_CHECKPOINT_CHUNK=1000


###############################################################################
# 16. COBRANÇA — MERCADO PAGO CHECKOUT PRO
###############################################################################
# Nunca commitar valores reais. Sem MERCADOPAGO_ACCESS_TOKEN o adaptador real fica
# DESABILITADO e o checkout diz isso na tela (nenhum endpoint é chamado).

# auto (real com credencial, fake sem) | fake | mercadopago
# Em produção seja explícito: `mercadopago`.
MERCADOPAGO_DRIVER=auto

# [PROD] sandbox | production. As credenciais é que definem o ambiente no provedor;
# esta chave existe para nunca misturarmos os dois do nosso lado — a aplicação
# recusa se não bater com o `live_mode` da credencial.
MERCADOPAGO_ENVIRONMENT=sandbox

# [PROD][SEG] Access Token da aplicação (backend). Começa com APP_USR.
MERCADOPAGO_ACCESS_TOKEN=
# [SEG] Só faria falta com SDK de frontend (não usamos).
MERCADOPAGO_PUBLIC_KEY=
# [PROD][SEG] Chave secreta de "Suas integrações > Webhooks > Configurar
# notificações", POR AMBIENTE. Sem ela o webhook responde 401 e NADA é processado —
# nenhum pagamento aprovado ativa plano.
MERCADOPAGO_WEBHOOK_SECRET=

# [PROD] HTTPS, pública, no máximo 248 caracteres, sem localhost.
# Vazio = usa route('webhooks.mercadopago').
MERCADOPAGO_NOTIFICATION_URL=
# Janela aceita entre o `ts` do cabeçalho x-signature e o relógio do servidor.
# Exige o relógio do servidor sincronizado (NTP).
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300

# HTTP: só repete em erro de conexão, 429 e 5xx, sempre com a MESMA X-Idempotency-Key.
MERCADOPAGO_TIMEOUT_SECONDS=20
MERCADOPAGO_CONNECT_TIMEOUT_SECONDS=10
MERCADOPAGO_RETRIES=2
MERCADOPAGO_RETRY_DELAY_MS=500

# Preferência do Checkout Pro.
# statement_descriptor aparece na fatura do cartão: no máximo 13 caracteres.
MERCADOPAGO_STATEMENT_DESCRIPTOR=ASSINAVELOX
# true = só aprovado ou recusado (pode reduzir a taxa de aprovação).
MERCADOPAGO_BINARY_MODE=false
MERCADOPAGO_PREFERENCE_TTL_HOURS=48
# Máximo de parcelas (1 a 36).
MERCADOPAGO_INSTALLMENTS=1
# Tipos de pagamento excluídos, separados por vírgula (ex.: ticket,atm).
# `account_money` NÃO pode ser excluído (regra do provedor; o valor é ignorado).
MERCADOPAGO_EXCLUDED_PAYMENT_TYPES=

# --- Ciclo de cobrança e inadimplência --------------------------------------
# Dias após o fim do período até a assinatura ir para `past_due` (bloqueia envio,
# mantém leitura e download) e, depois, até `expired` (volta ao plano Grátis).
ASSINAVELOX_BILLING_GRACE_DAYS=3
ASSINAVELOX_BILLING_EXPIRED_DAYS=15

# [PROD] Dados da operadora impressos no recibo interno — que NÃO é documento fiscal.
# Preencha com a razão social e o CNPJ reais antes de faturar.
ASSINAVELOX_OPERATOR_NAME=AssinaVelox
ASSINAVELOX_OPERATOR_LEGAL_NAME=
ASSINAVELOX_OPERATOR_TAX_ID=


###############################################################################
# 17. HORIZON  (produção)
###############################################################################

# Nome desta instância no painel (vazio = hostname).
HORIZON_NAME=
# Domínio dedicado do painel (vazio = mesmo domínio da aplicação).
HORIZON_DOMAIN=
# Caminho do painel. O acesso é controlado por HorizonServiceProvider::gate().
HORIZON_PATH=horizon
# Prefixo das chaves no Redis (vazio = derivado de APP_NAME). Obrigatório separar
# se dois ambientes compartilharem o mesmo Redis.
HORIZON_PREFIX=

# Processos por supervisor no ambiente `production`.
HORIZON_DEFAULT_PROCESSES=6
HORIZON_CONVERSIONS_PROCESSES=2
HORIZON_FINALIZATION_PROCESSES=2


###############################################################################
# 18. AUTENTICAÇÃO (padrões do Laravel — raramente alterados)
###############################################################################

AUTH_GUARD=web
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# Segundos de validade da confirmação de senha.
AUTH_PASSWORD_TIMEOUT=10800


###############################################################################
# 19. FRONTEND E TESTES
###############################################################################

VITE_APP_NAME="${APP_NAME}"

# Exigir que o componente da página exista em resources/js/pages (usado em testes).
INERTIA_ENSURE_PAGES_EXIST=false

# Difusão de eventos: não usada na Fase 1.
BROADCAST_CONNECTION=log


###############################################################################
# 20. DRIVERS ALTERNATIVOS — NÃO USADOS NA FASE 1
###############################################################################
# Ficam listados porque config/*.php os lê; deixe comentados. Descomentar só faz
# sentido se você trocar o driver correspondente.

# --- Banco: PostgreSQL / SQL Server -----------------------------------------
# DB_SSLMODE=prefer
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false

# --- Cache: Memcached / DynamoDB --------------------------------------------
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

# --- Fila: Beanstalkd / SQS -------------------------------------------------
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/sua-conta
# SQS_QUEUE=default
# SQS_SUFFIX=

# --- Log: Papertrail / Slack ------------------------------------------------
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_PAPERTRAIL_HANDLER=
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME=
# LOG_SLACK_EMOJI=:boom:

# --- Serviços de terceiros não integrados na Fase 1 -------------------------
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# Fase 2, onda B — todas desligadas por padrão (docs/fase-2/onda-b-relatorio.md).
# Cada flag também precisa estar ligada no plano da organização (plans.features).
ASSINAVELOX_FEATURE_SMS_WHATSAPP=false
ASSINAVELOX_FEATURE_PIN_AUTH=false
ASSINAVELOX_FEATURE_SENDER_DOMAINS=false
ASSINAVELOX_FEATURE_BRANDING=false
ASSINAVELOX_FEATURE_CPF_FIELD=false
ASSINAVELOX_FEATURE_CPF_LOOKUP=false
ASSINAVELOX_FEATURE_CNPJ_LOOKUP=false
ASSINAVELOX_FEATURE_IDENTITY_CAPTURE=false
ASSINAVELOX_FEATURE_IN_PERSON=false
ASSINAVELOX_FEATURE_BATCH_SIGNING=false
ASSINAVELOX_FEATURE_PUBLIC_FORMS=false
# Canais: simulador identificado (padrão: ligado fora de produção). Produção sem serviço = indisponível.
# ASSINAVELOX_CHANNELS_ALLOW_SIMULATED=
ASSINAVELOX_SMS_DRIVER=fake
ASSINAVELOX_WHATSAPP_DRIVER=fake
# Consulta cadastral de CPF: `disabled` até o serviço próprio ter documentação.
ASSINAVELOX_CPF_LOOKUP_DRIVER=disabled

# Fase 2, onda C — todas desligadas por padrão (docs/fase-2/onda-c-relatorio.md).
# `participant_a1`, `dossier_export` e `retention_policies` também precisam estar no plano.
# `operator_tsa` e `pades_bt` são da plataforma; nenhuma muda o perfil anunciado (PAdES-B-B).
ASSINAVELOX_FEATURE_PARTICIPANT_A1=false
ASSINAVELOX_FEATURE_OPERATOR_TSA=false
ASSINAVELOX_FEATURE_PADES_BT=false
ASSINAVELOX_FEATURE_DOSSIER_EXPORT=false
ASSINAVELOX_FEATURE_RETENTION_POLICIES=false
# TSA da operadora (docs/fase-2/carimbo-e-dossie.md §2.4). A SENHA nunca vai aqui: só o NOME
# da variável que a contém. `php artisan tsa:generate-test` gera uma TSA de TESTE.
# ASSINAVELOX_TSA_PFX_PATH=
# ASSINAVELOX_TSA_PASSWORD_ENV=ASSINAVELOX_TSA_PASSWORD
# ASSINAVELOX_TSA_CHAIN_PEM=
# ASSINAVELOX_TSA_TRUST_ROOTS=
# ASSINAVELOX_TSA_ENVIRONMENT=test
# ASSINAVELOX_TSA_ICP_BRASIL_DRIVER=disabled
# Retenção: hidden | notice | notice_with_final_hash (docs/fase-2/retencao-e-preservacao.md §6).
# ASSINAVELOX_RETENTION_VERIFICATION=notice_with_final_hash

# Fase 2, onda D — todas desligadas por padrão (docs/fase-2/entrega-fase-2.md §3).
# `api_integrations`, `outbound_webhooks` e `rest_hooks` também precisam estar no plano;
# `rest_hooks` só vale com as outras duas ligadas. `extended_payments` e `fiscal_invoices` são
# da plataforma. Webhooks: só ligar depois do teste do pino de IP (R6) e de um teste de fumaça
# contra um endpoint https real (docs/fase-2/webhooks.md §6.4).
ASSINAVELOX_FEATURE_API_INTEGRATIONS=false
ASSINAVELOX_FEATURE_OUTBOUND_WEBHOOKS=false
ASSINAVELOX_FEATURE_REST_HOOKS=false
ASSINAVELOX_FEATURE_EXTENDED_PAYMENTS=false
ASSINAVELOX_FEATURE_FISCAL_INVOICES=false
# Webhooks: `default` funciona com qualquer worker; fila própria exige incluí-la no Horizon.
# ASSINAVELOX_WEBHOOKS_QUEUE=default
# Cobrança: meios oferecidos (pix,boleto,card) e quem pode pedir estorno (platform_admin[,owner]).
# MERCADOPAGO_ENABLED_METHODS=pix,boleto,card
# ASSINAVELOX_BILLING_REFUND_INITIATORS=platform_admin
# ASSINAVELOX_BILLING_ALERT_EMAIL=
# Assinaturas recorrentes: disabled | simulated (simulador só fora de produção).
# MERCADOPAGO_PREAPPROVAL_DRIVER=disabled
# NFS-e: none | simulated (só fora de produção) | sefin_nacional (bloqueado até os dados da operadora).
# ASSINAVELOX_FISCAL_PROVIDER=none

# Fase 3, onda G — todas desligadas por padrão (docs/fase-3/entrega-fase-3.md §3). Também
# precisam estar no plano. `embedded_signing` exige `api_integrations` (a sessão nasce na API v1).
# SSO, Drive, Dropbox e HubSpot são classe B: sem os apps/IdP registrados pelo proprietário as
# telas dizem "ainda não disponível"/"aguardando app registrado pelo proprietário".
ASSINAVELOX_FEATURE_EMBEDDED_SIGNING=false
ASSINAVELOX_FEATURE_SSO_OIDC=false
ASSINAVELOX_FEATURE_SSO_SAML=false
ASSINAVELOX_FEATURE_CLOUD_IMPORT=false
ASSINAVELOX_FEATURE_HUBSPOT=false
# SSO: só `true` depois do teste com um provedor de identidade REAL (docs/fase-3/sso.md).
ASSINAVELOX_SSO_HOMOLOGATED=false
# Apps dos conectores (docs/fase-3/conectores.md §2). Segredos só no ambiente, nunca no banco.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=
DROPBOX_APP_KEY=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=

# --- Recursos das Fases 2 e 3 ainda sem entrada acima (todos nascem desligados; ---
#     ligue por recurso, global E plano — docs/fase-3/entrega-fase-3.md §3) ---
ASSINAVELOX_FEATURE_A=false
ASSINAVELOX_FEATURE_ADMIN_AUDIT=false
ASSINAVELOX_FEATURE_ADMIN_USERS=false
ASSINAVELOX_FEATURE_AFFILIATES=false
ASSINAVELOX_FEATURE_ANTIFRAUD=false
ASSINAVELOX_FEATURE_AUDIT_LOG=false
ASSINAVELOX_FEATURE_BULK_GENERATION=false
ASSINAVELOX_FEATURE_CONDITIONAL_STEPS=false
ASSINAVELOX_FEATURE_CUSTOM_ROLES=false
ASSINAVELOX_FEATURE_DELEGATION=false
ASSINAVELOX_FEATURE_FIELD_ANCHORS=false
ASSINAVELOX_FEATURE_GOVBR_RETURN=false
ASSINAVELOX_FEATURE_IDENTITY_VIDEO=false
ASSINAVELOX_FEATURE_IMPERSONATION=false
ASSINAVELOX_FEATURE_MULTILINGUAL=false
ASSINAVELOX_FEATURE_MULTI_DOCUMENT=false
ASSINAVELOX_FEATURE_OCR=false
ASSINAVELOX_FEATURE_PADES_LTV=false
ASSINAVELOX_FEATURE_PADES_LTV_ADVERTISE=false
ASSINAVELOX_FEATURE_PARTICIPANT_A=false
ASSINAVELOX_FEATURE_PARTICIPANT_ROLES=false
ASSINAVELOX_FEATURE_REMINDERS=false
ASSINAVELOX_FEATURE_REPORTS=false
ASSINAVELOX_FEATURE_TAGS=false
ASSINAVELOX_FEATURE_TEMPLATES=false
