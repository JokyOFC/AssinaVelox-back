APP_NAME=AssinaVelox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assinavelox
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@assinavelox.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AssinaVelox -------------------------------------------------------------
# Versão dos Termos de uso registrada no cadastro e no aceite eletrônico.
ASSINAVELOX_TERMS_VERSION=2026-09
# Prazo padrão (dias) para assinatura; cada organização pode alterar (1–90).
ASSINAVELOX_DEFAULT_EXPIRATION_DAYS=30
# Código por e-mail (OTP): validade em minutos, tentativas por desafio, reenvios/hora.
ASSINAVELOX_OTP_TTL_MINUTES=10
ASSINAVELOX_OTP_MAX_ATTEMPTS=5
ASSINAVELOX_OTP_RESEND_LIMIT=5
# Sessão do signatário após confirmar o código (minutos) e token de autorização do aceite.
ASSINAVELOX_SIGNING_SESSION_TTL_MINUTES=30
ASSINAVELOX_AUTHORIZATION_TTL_MINUTES=10
# Reenvio manual de convite: intervalo mínimo por destinatário (min) e máximo padrão.
ASSINAVELOX_RESEND_THROTTLE_MINUTES=10
ASSINAVELOX_MAX_RESENDS=5
# Unidade de consumo do plano (Fase 1: envelope_sent).
ASSINAVELOX_PLAN_CONSUMPTION_UNIT=envelope_sent
# Exibição de IP na página de evidências: masked | full | none.
ASSINAVELOX_EVIDENCE_SHOW_IP=masked
# Tamanho máximo de upload (MB).
ASSINAVELOX_MAX_UPLOAD_MB=25
# Validade dos convites de membros (dias).
ASSINAVELOX_INVITATION_EXPIRES_DAYS=7
# Cache dos contadores da sidebar: TTL (s) e store (vazio = CACHE_STORE).
ASSINAVELOX_COUNTS_CACHE_TTL=60
ASSINAVELOX_COUNTS_CACHE_STORE=
# Dias entre a solicitação de exclusão da organização e a exclusão efetiva.
ASSINAVELOX_ORG_DELETION_GRACE_DAYS=30
# CSP: ativar, modo somente-relatório e origens extras (separadas por vírgula).
ASSINAVELOX_CSP_ENABLED=true
ASSINAVELOX_CSP_REPORT_ONLY=false
ASSINAVELOX_CSP_EXTRA_SOURCES=
# Links de ajuda/suporte exibidos na interface.
ASSINAVELOX_HELP_URL=https://ajuda.assinavelox.com.br
ASSINAVELOX_SUPPORT_EMAIL=suporte@assinavelox.com.br

# Proxies confiáveis (X-Forwarded-*): lista de IPs/CIDRs do balanceador, separada por vírgula
# (ex.: 10.0.0.0/8). Vazio = nenhum. Define o IP registrado nos aceites e nos eventos de auditoria
# e a chave dos limitadores por IP.
# NÃO use "*": ele significa "confie em qualquer origem", e então o X-Forwarded-For passa a ser
# escrito pelo próprio cliente. Por segurança, com "*" a aplicação IGNORA o X-Forwarded-For (o IP
# volta a ser o do socket, ou seja, o do balanceador) e mantém apenas X-Forwarded-Proto/Port.
TRUSTED_PROXIES=

# Cookies de sessão só via HTTPS (padrão: true em produção). Deixe vazio para o padrão.
SESSION_SECURE_COOKIE=

# Disco privado dos documentos: local (storage/app/documents) ou s3 (S3 compatível).
DOCUMENTS_DISK=local
DOCUMENTS_S3_KEY=
DOCUMENTS_S3_SECRET=
DOCUMENTS_S3_REGION=
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_USE_PATH_STYLE_ENDPOINT=false
DOCUMENTS_S3_ROOT=

# Filas: dev usa 'database' (php artisan queue:work --queue=default,conversions,notifications,finalization,billing).
# Produção: QUEUE_CONNECTION=redis + Horizon (php artisan horizon). Processos por supervisor:
HORIZON_DEFAULT_PROCESSES=6
HORIZON_CONVERSIONS_PROCESSES=2
HORIZON_FINALIZATION_PROCESSES=2

# Ferramentas externas: Python do pdftool e binário do LibreOffice.
# PDFTOOL_PYTHON vazio → usa o venv padrão em tools/pdftool/.venv (php artisan pdftool:selftest).
# LIBREOFFICE_BIN vazio → conversão DOCX indisponível (ConverterNotConfiguredException); nos testes
# o adaptador fake é escolhido via config('pdftool.converters.docx').
PDFTOOL_PYTHON=
LIBREOFFICE_BIN=
# Timeouts (segundos) dos processos do pdftool (inspeção/composição), da assinatura e do LibreOffice.
PDFTOOL_TIMEOUT_SECONDS=60
PDFTOOL_SIGN_TIMEOUT_SECONDS=120
LIBREOFFICE_TIMEOUT_SECONDS=120
# Diretório temporário exclusivo do pdftool (vazio = storage/app/tmp/pdftool).
PDFTOOL_TMP_PATH=
# Raízes de confiança (PEM/DER) usadas na validação da assinatura PAdES, separadas por ";".
PDFTOOL_TRUST_ROOTS=

# Certificado A1 da operadora (PAdES B-B). Apenas REFERÊNCIAS: caminho do PFX e o NOME da
# variável que contém a senha (a senha nunca vai para banco, fila ou log).
COMPANY_CERT_ENABLED=false
COMPANY_CERT_ENVIRONMENT=test
COMPANY_CERT_PFX_PATH=
COMPANY_CERT_PASSWORD_ENV=COMPANY_CERT_PASSWORD
COMPANY_CERT_NAME="Certificado da operadora"
# Motivo e local gravados no campo de assinatura PAdES.
COMPANY_CERT_REASON="Assinatura eletrônica AssinaVelox"
COMPANY_CERT_LOCATION=Brasil
# A senha do PFX (variável COMPANY_CERT_PASSWORD, ou o nome definido em COMPANY_CERT_PASSWORD_ENV)
# NÃO deve ficar neste arquivo: defina-a só no ambiente do processo (EnvironmentFile do systemd /
# pool do PHP-FPM). Com `config:cache` o .env não é lido em tempo de execução.

# Mercado Pago Checkout Pro (sandbox | production). Nunca commitar valores reais.
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=

# Inertia: exigir que o componente da página exista em resources/js/pages (testes).
INERTIA_ENSURE_PAGES_EXIST=false
