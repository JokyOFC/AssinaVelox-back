        <env name="ASSINAVELOX_FEATURE_CNPJ_LOOKUP" value="false"/>
        <env name="ASSINAVELOX_FEATURE_CONDITIONAL_STEPS" value="false"/>
        <env name="ASSINAVELOX_FEATURE_CPF_FIELD" value="false"/>
        <env name="ASSINAVELOX_FEATURE_CPF_LOOKUP" value="false"/>
        <env name="ASSINAVELOX_FEATURE_CUSTOM_ROLES" value="false"/>
